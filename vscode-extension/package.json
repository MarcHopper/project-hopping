{
  "name": "hopping-watcher",
  "displayName": "Hopping",
  "description": "Reports your current project + finished agents to the local Hopping hub.",
  "version": "0.1.0",
  "publisher": "tmhopper",
  "private": true,
  "engines": { "vscode": "^1.93.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "hopping", "title": "Hopping", "icon": "media/rocket.svg" }
      ]
    },
    "views": {
      "hopping": [{ "id": "hopping.grid", "name": "Hop grid" }]
    },
    "commands": [
      { "command": "hopping.markWaiting", "title": "Hopping: Mark current project as waiting on you" },
      { "command": "hopping.openGrid", "title": "Hopping: Open the hop grid" },
      { "command": "hopping.refresh", "title": "Hopping: Refresh", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "hopping.refresh", "when": "view == hopping.grid", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Hopping",
      "properties": {
        "hopping.hubPort": {
          "type": "number",
          "default": 4319,
          "description": "Port of the local Hopping hub."
        },
        "hopping.agentCommandPattern": {
          "type": "string",
          "default": "claude|cursor|aider|codex|gemini|llm|gpt|opencode|goose",
          "description": "Regex (case-insensitive): a finished terminal command matching this flips the project to 'waiting on you'."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "node esbuild.js --production",
    "package": "npm run check-types && npm run build && npx --yes @vscode/vsce package --no-dependencies -o hopping-watcher.vsix"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.24.0",
    "typescript": "^5"
  }
}
